# ===========================================
# MarcoAI Environment Configuration
# ===========================================
# Required fields are marked with [REQUIRED].
# Optional fields have sensible defaults or are marked [OPTIONAL].

# ── Google OAuth [REQUIRED] ─────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── LLM Providers [REQUIRED] ───────────────────────────────────────────────
GROQ_API_KEY=
OPENROUTER_API_KEY=

# ── Google API [REQUIRED] ──────────────────────────────────────────────────
GOOGLE_API_KEY=

# ── JWT / Security ─────────────────────────────────────────────────────────
# Auto-generated on first run if empty, then persisted to .env.
# Only set manually if you need a specific key.
SECRET_KEY=

# ── Encryption [REQUIRED] ──────────────────────────────────────────────────
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ── Database [OPTIONAL] ────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./data/marcoai.db

# ── CORS / Frontend [OPTIONAL] ─────────────────────────────────────────────
FRONTEND_URL=

# ── Cloudflare Tunnel [OPTIONAL] ───────────────────────────────────────────
CLOUDFLARE_TUNNEL_TOKEN=

# ── Rate Limiting [OPTIONAL] ───────────────────────────────────────────────
RATE_LIMIT_RPM=30
