# ============================================
# REQUIRED — Authentication & Security
# ============================================
GOOGLE_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ENCRYPTION_KEY=
DATABASE_URL=sqlite+aiosqlite:///./marcoai.db

# JWT signing key — auto-generated on first run if empty, then persisted
SECRET_KEY=

# ============================================
# REQUIRED — Frontend
# ============================================
FRONTEND_URL=http://localhost:5173

# ============================================
# OPTIONAL — LLM Providers (fallback chain)
# ============================================
# GROQ_API_KEY=
# OPENROUTER_API_KEY=

# ============================================
# OPTIONAL — Notifications
# ============================================
# ENABLE_NOTIFICATIONS=true

# ============================================
# OPTIONAL — Rate Limiting
# ============================================
# RATE_LIMIT_RPM=30           # Max requests per minute per user (default: 30)

# ============================================
# OPTIONAL — Tunnels
# ============================================
# CLOUDFLARE_TUNNEL_TOKEN=
